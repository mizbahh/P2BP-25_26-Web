rules_version = '2';
// Local-emulator-only rules. The Express server talks to Firestore via the Admin
// SDK, which bypasses these rules entirely - this file only exists because the
// emulator refuses to start without one. Not used against real Firestore.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
